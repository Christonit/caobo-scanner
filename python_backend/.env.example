# Google Gemini API key
GEMINI_API_KEY=

# Optional: persist token spend to Supabase (public.api_token_usage).
# Requires the migration 20260722000001_api_token_usage.sql applied, and
# upload/scan requests to include user_id + organization_id form fields.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# Thinking speed → model mapping
#   rapido   → 3.1 Flash Lite (structured JSON output)
#   moderado → 3.5 Flash Lite (thinking budget)
#   profundo → 3.6 Flash (deep)
# ---------------------------------------------------------------------------
THINKING_LEVEL_RAPIDO_MODEL=gemini-3.1-flash-lite
THINKING_LEVEL_MODERADO_MODEL=gemini-3.5-flash-lite
THINKING_LEVEL_PROFUNDO_MODEL=gemini-3.6-flash

# Thinking tokens for moderado (Gemini 3 Flash). 0 disables thinking.
THINKING_BUDGET_MODERADO=1024
# Optional deep budget for profundo (unset = model default)
# THINKING_BUDGET_PROFUNDO=2048

# ---------------------------------------------------------------------------
# USD cost per 1,000,000 tokens, keyed by thinking speed.
# cost = ((prompt - cached)/1e6)*INPUT
#      + (cached/1e6)*CACHED_INPUT
#      + (completion/1e6)*OUTPUT
# ---------------------------------------------------------------------------

TOKEN_COST_RAPIDO_INPUT_PER_1M=0.10
TOKEN_COST_RAPIDO_OUTPUT_PER_1M=0.40
TOKEN_COST_RAPIDO_CACHED_INPUT_PER_1M=0.025

TOKEN_COST_MODERADO_INPUT_PER_1M=0.075
TOKEN_COST_MODERADO_OUTPUT_PER_1M=0.30
TOKEN_COST_MODERADO_CACHED_INPUT_PER_1M=0.01875

TOKEN_COST_PROFUNDO_INPUT_PER_1M=0.30
TOKEN_COST_PROFUNDO_OUTPUT_PER_1M=2.50
TOKEN_COST_PROFUNDO_CACHED_INPUT_PER_1M=0.075
