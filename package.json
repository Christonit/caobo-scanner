{
  "name": "caobo-recibos",
  "version": "1.0.0",
  "description": "Smart Accounting Desktop Agent",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "python:build": "cd python_backend && python3 -m PyInstaller backend.spec --clean",
    "electron:build": "npm run generate && npm run python:build && electron-builder",
    "electron:build:mac": "npm run generate && npm run python:build && electron-builder --mac",
    "electron:build:win": "npm run generate && npm run python:build && electron-builder --win",
    "electron:build:linux": "npm run generate && npm run python:build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.caobo.recibos",
    "productName": "Caobo Recibos",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".output/public/**/*"
    ],
    "extraResources": [
      {
        "from": "python_backend/dist/backend",
        "to": "backend"
      },
      {
        "from": "python_backend/template.xls",
        "to": "template.xls"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "latest",
    "nuxt": "latest",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@pinia/nuxt": "latest",
    "pinia": "latest"
  }
}
