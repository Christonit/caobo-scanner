# Backend API base (FastAPI)
NUXT_PUBLIC_API_BASE=http://localhost:8000

# --- PostHog (session replay + analytics) ---------------------------------
# Project API key from PostHog → Project settings. Safe for the browser.
# Also enable "Record user sessions" under Session replay in the PostHog UI.
NUXT_PUBLIC_POSTHOG_KEY=phc_...
# US cloud (default). Use https://eu.i.posthog.com for EU.
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Feature flags ---------------------------------------------------------
# Read at runtime via `useFeatureFlags()` (see composables/useFeatureFlags.ts).
# Defaults are defined in nuxt.config.ts under runtimeConfig.public.features;
# uncomment to override per environment. Boolean values are case-insensitive.
#
# Disable to run the app fully anonymously (no /login, /signup, /onboarding,
# /team; no Supabase session required to reach /).
# NUXT_PUBLIC_FEATURES_AUTH=true
#
# Hide the /team page and its navbar link.
# NUXT_PUBLIC_FEATURES_TEAM=true

# --- Supabase --------------------------------------------------------------
# Only needed when NUXT_PUBLIC_FEATURES_AUTH is true (the default).
#
# Use the NUXT_PUBLIC_* names in production (Railway, Docker, etc.) so Nuxt
# can read them at runtime without rebuilding. Legacy SUPABASE_* names still
# work for local `nuxt dev` / `nuxt build` when a .env file is present.
#
# Project URL (from Supabase dashboard -> Settings -> API)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key — safe for the browser
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Server-only — new "Secret" key (`sb_secret_xxx`) from
# Project Settings -> API Keys. NEVER ship to the browser.
# Used by /server/api/** routes that need to bypass RLS.
NUXT_SUPABASE_SECRET_KEY=sb_secret_...
